{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "type": "object",
    "properties": {
        "code-prefix": { "type": "string" },
        "cache": { "type": "string" },
        "def-formats": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "markers": {
                        "type": "array",
                        "items": { "type": "string", "pattern": "^[\\w\\d_]+$" },
                        "minItems": 1
                    },
                    "template": { "type": "string" },
                    "back-ref-template": { "type": "string" },
                    "back-ref-delimiter": { "type": "string" }
                },
                "required": ["markers"],
                "additionalProperties": false
            }
        },
        "ref-formats": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "markers": {
                        "type": "array",
                        "items": { "type": "string", "pattern": "^[\\w\\d_]+$" },
                        "minItems": 1
                    },
                    "template": { "type": "string" }
                },
                "required": ["markers"],
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}
